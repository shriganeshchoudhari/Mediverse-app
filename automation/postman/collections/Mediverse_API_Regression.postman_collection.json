        {
          "name": "Evaluate SOAP Note Grading",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subjective\": \"45yo male with crushing retrosternal chest pain radiating to left arm\",\n  \"objective\": \"BP 150/95, HR 102, ST elevations in V1-V4\",\n  \"assessment\": \"Acute Anterior STEMI\",\n  \"plan\": \"DAPT Aspirin 300mg + Ticagrelor 180mg, immediate cath lab activation\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/emr/soap-grade/evaluate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "emr", "soap-grade", "evaluate"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "07. Multi-Tenant Administration",
      "item": [
        {
          "name": "Get All Tenants (Admin Protected)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "X-Tenant-ID", "value": "mediverse-default" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/tenants",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "tenants"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK or 403 Forbidden', function () {",
                  "    pm.expect([200, 403]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
