              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/curriculum/ayush/bams/subjects",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "curriculum", "ayush", "bams", "subjects"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
