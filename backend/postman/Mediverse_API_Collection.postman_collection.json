    {
      "name": "3. Grounded AI Content Generator & Socratic Tutor",
      "item": [
        {
          "name": "Generate MCQ Quiz from Text",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Ventricular action potential Phase 0 is mediated by fast voltage-gated Na+ channels.\",\n  \"count\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ai/generate/quiz",
              "host": ["{{baseUrl}}"],
              "path": ["ai", "generate", "quiz"]
            }
          }
        },
        {
          "name": "Generate Cloze Flashcards",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Propionate is the only volatile fatty acid in ruminants converted into glucose.\",\n  \"count\": 3\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ai/generate/flashcards",
              "host": ["{{baseUrl}}"],
              "path": ["ai", "generate", "flashcards"]
            }
          }
        },
        {
          "name": "Generate Prescription Protocol Card",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Acute STEMI first-line pharmacotherapy: Aspirin 300mg loading dose and Ticagrelor 180mg.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ai/generate/rx-card",
              "host": ["{{baseUrl}}"],
              "path": ["ai", "generate", "rx-card"]
            }
          }
        },
        {
          "name": "Generate Clinical Decision Tree",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Anaphylaxis triage: Airway assessment followed by immediate IM adrenaline into anterolateral thigh.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ai/generate/decision-tree",
              "host": ["{{baseUrl}}"],
              "path": ["ai", "generate", "decision-tree"]
            }
          }
        },
        {
          "name": "Query RAG Clinical Knowledge Embeddings",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"Winter formula metabolic acidosis compensation range\",\n  \"topK\": 3\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ai/rag/search",
              "host": ["{{baseUrl}}"],
              "path": ["ai", "rag", "search"]
            }
          }
        }
      ]
    },
    {
      "name": "4. EMR, CPOE Orders & SOAP Grading",
      "item": [
        {
          "name": "Get All Patients",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/emr/patients",
              "host": ["{{baseUrl}}"],
              "path": ["emr", "patients"]
            }
          }
        },
        {
          "name": "Get Patient Chart",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/emr/patients/00000000-0000-0000-0000-000000000001/chart",
              "host": ["{{baseUrl}}"],
              "path": ["emr", "patients", "00000000-0000-0000-0000-000000000001", "chart"]
            }
          }
        },
        {
          "name": "Add Clinical Progress Note",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"noteType\": \"PROGRESS\",\n  \"subjective\": \"Patient reports improved dyspnea with diuresis.\",\n  \"objective\": \"JVP 3cm, bilateral basal crackles decreased, SpO2 96% on room air.\",\n  \"assessment\": \"Acute Decompensated Heart Failure resolving.\",\n  \"plan\": \"Continue Furosemide 40mg IV BID, monitor daily weights and serum potassium.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/emr/patients/00000000-0000-0000-0000-000000000001/notes",
              "host": ["{{baseUrl}}"],
              "path": ["emr", "patients", "00000000-0000-0000-0000-000000000001", "notes"]
            }
          }
        },
        {
          "name": "Place CPOE Order with Contraindication Check",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": \"00000000-0000-0000-0000-000000000001\",\n  \"orderType\": \"MEDICATION\",\n  \"orderName\": \"Metoprolol Tartrate\",\n  \"dose\": \"25 mg\",\n  \"route\": \"PO\",\n  \"frequency\": \"BID\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/emr/orders?systolicBp=130.0",
              "host": ["{{baseUrl}}"],
              "path": ["emr", "orders"],
              "query": [{ "key": "systolicBp", "value": "130.0" }]
            }
          }
        },
        {
          "name": "Evaluate SOAP Note Auto-Grading",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subjective\": \"Crushing retrosternal chest pain radiating to left jaw\",\n  \"objective\": \"ST segment elevation in leads II, III, aVF\",\n  \"assessment\": \"Inferior Wall Myocardial Infarction\",\n  \"plan\": \"Dual antiplatelet therapy, anticoagulation, emergency angiography\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/emr/soap-grade/evaluate",
              "host": ["{{baseUrl}}"],
              "path": ["emr", "soap-grade", "evaluate"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Physiological Simulations & Solvers",
      "item": [
        {
          "name": "Get Simulation Catalog",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/simulations/catalog",
              "host": ["{{baseUrl}}"],
              "path": ["simulations", "catalog"]
            }
          }
        },
        {
          "name": "Calculate PV Loop Hemodynamics",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"preloadEdv\": 120.0,\n  \"afterloadSvr\": 100.0,\n  \"inotropyEes\": 2.5,\n  \"heartRate\": 75.0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/simulations/calculate",
              "host": ["{{baseUrl}}"],
              "path": ["simulations", "calculate"]
            }
          }
        },
        {
          "name": "Save Simulation Run",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"simulationType\": \"CARDIOVASCULAR_PV_LOOP\",\n  \"inputParameters\": \"{\\\"preloadEdv\\\": 120.0, \\\"afterloadSvr\\\": 100.0}\",\n  \"outcomeMetrics\": \"{\\\"strokeVolume\\\": 72.0, \\\"ejectionFraction\\\": 60.0}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/simulations",
              "host": ["{{baseUrl}}"],
              "path": ["simulations"]
            }
          }
        },
        {
          "name": "Get My Saved Simulation Runs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/simulations",
              "host": ["{{baseUrl}}"],
              "path": ["simulations"]
            }
          }
        }
      ]
    },
