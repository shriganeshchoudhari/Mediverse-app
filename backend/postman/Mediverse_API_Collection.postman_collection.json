    {
      "name": "7. Multi-Tenant Administration",
      "item": [
        {
          "name": "List All Tenants",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "X-Tenant-ID", "value": "mediverse-default" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/tenants",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "tenants"]
