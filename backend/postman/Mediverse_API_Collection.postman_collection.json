              "path": ["admin", "stats"]
            }
          }
        }
      ]
    },
    {
      "name": "8. Actuator & Observability",
      "item": [
        {
          "name": "Health Status",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8085/actuator/health",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8085",
              "path": ["actuator", "health"]
            }
          }
        },
        {
          "name": "Prometheus Metrics",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8085/actuator/prometheus",
              "protocol": "http",
              "host": ["localhost"],
