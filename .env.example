# =============================================================================
# Mediverse Medical Education & Simulation Platform
# Environment Variables Reference
# Copy this file to .env and fill in your values before starting the stack.
# NEVER commit .env with real secrets to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Spring Boot Backend — Database (PostgreSQL 16 via docker-compose)
# ---------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mediverse_db
SPRING_DATASOURCE_USERNAME=mediverse_user
SPRING_DATASOURCE_PASSWORD=mediverse_secure_password123

# ---------------------------------------------------------------------------
# Spring Boot Backend — Redis Cache
# ---------------------------------------------------------------------------
SPRING_DATA_REDIS_HOST=localhost
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Spring Boot Backend — Elasticsearch
# ---------------------------------------------------------------------------
SPRING_ELASTICSEARCH_URIS=http://localhost:9200

# ---------------------------------------------------------------------------
# JWT Authentication
# ---------------------------------------------------------------------------
# Generate a strong 256-bit base64 secret:
# openssl rand -base64 32
JWT_SECRET=c3VwZXItc2VjcmV0LWtleS1zaG91bGQtYmUtYXQtbGVhc3QtMjU2LWJpdHMtbG9uZy1mb3Itc2VjdXJpdHk=
JWT_EXPIRATION=86400000

# ---------------------------------------------------------------------------
# Server Port
# ---------------------------------------------------------------------------
PORT=8085

# ---------------------------------------------------------------------------
# Gemini AI Tutor API Key
# ---------------------------------------------------------------------------
# Obtain from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8085
INTERNAL_API_URL=http://localhost:8085

# ---------------------------------------------------------------------------
# Production-only variables (set in CI/CD secrets — NOT here)
# ---------------------------------------------------------------------------
# PROD_DB_URL=jdbc:postgresql://<rds-endpoint>:5432/mediverse_db
# PROD_DB_USERNAME=mediverse_prod_user
# PROD_DB_PASSWORD=<strong-password>
# PROD_JWT_SECRET=<256-bit-base64>
# PROD_REDIS_HOST=<elasticache-endpoint>
# PROD_REDIS_PORT=6379
# PROD_REDIS_PASSWORD=<redis-auth-token>
# PROD_ELASTICSEARCH_URIS=https://<opensearch-endpoint>
