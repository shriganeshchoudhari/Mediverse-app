{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.2.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" },
    { "type": "panel", "id": "text", "name": "Text", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "Mediverse QA Engineering KPI Dashboard — 7 core metrics with trend history",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "targetBlank": true,
      "title": "Allure Reports",
      "tooltip": "View detailed test reports",
      "type": "link",
      "url": "https://shriganeshchoudhari.github.io/Mediverse-app/reports/allure/"
    },
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "targetBlank": true,
      "title": "GitHub Actions",
      "tooltip": "View CI/CD pipeline runs",
      "type": "link",
      "url": "https://github.com/shriganeshchoudhari/Mediverse-app/actions"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 2 },
      "options": {
        "mode": "markdown",
        "content": "# 🏥 Mediverse QA Engineering Dashboard\n**Platform:** AI-Powered Medical Education | **Env:** ${env} | **Updated:** auto-refresh 5m"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Overall Test Pass Rate",
      "description": "Automation Coverage × Pass Rate across all suites",
      "gridPos": { "x": 0, "y": 2, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 85 },
              { "color": "green", "value": 95 }
            ]
          },
          "color": { "mode": "thresholds" },
          "mappings": []
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * sum(mediverse_test_suite_pass_total) / (sum(mediverse_test_suite_pass_total) + sum(mediverse_test_suite_fail_total))",
          "legendFormat": "Pass Rate %",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Automation Coverage",
      "description": "Automated test cases / total automatable × 100",
      "gridPos": { "x": 4, "y": 2, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "green", "value": 85 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "mediverse_automation_coverage_percent",
          "legendFormat": "Automation %",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Defect Escape Rate",
      "description": "Production defects / total defects × 100 — Target < 2%",
      "gridPos": { "x": 8, "y": 2, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 20,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "red", "value": 5 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "mediverse_defect_escape_rate_percent",
          "legendFormat": "DER %",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Flaky Test Rate",
      "description": "Flaky executions / total executions × 100 — Target < 1%",
      "gridPos": { "x": 12, "y": 2, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 10,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * mediverse_flaky_test_count / mediverse_test_total_executions",
          "legendFormat": "Flaky %",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "JaCoCo Coverage (Backend)",
      "description": "Backend code coverage from JaCoCo — Target ≥ 80%",
      "gridPos": { "x": 16, "y": 2, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "green", "value": 80 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "mediverse_jacoco_line_coverage_percent",
          "legendFormat": "Coverage %",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "MTTR (S1 Defects)",
      "description": "Mean Time to Resolve Severity-1 defects — Target < 4 hours",
      "gridPos": { "x": 20, "y": 2, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 4 },
              { "color": "red", "value": 8 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "mediverse_defect_mttr_hours{severity='S1'}",
          "legendFormat": "S1 MTTR",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Test Pass / Fail Trend (7d)",
      "description": "Pass and fail counts per suite over last 7 days",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Failed" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Passed" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          }
        ]
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (suite) (mediverse_test_suite_pass_total)",
          "legendFormat": "Passed - {{suite}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (suite) (mediverse_test_suite_fail_total)",
          "legendFormat": "Failed - {{suite}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Test Suite Execution Duration (mins)",
      "description": "CI pipeline duration per suite over time",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "custom": { "lineWidth": 2, "fillOpacity": 5 }
        }
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "mediverse_test_suite_duration_seconds / 60",
          "legendFormat": "{{suite}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "gauge",
      "title": "QA Maturity Level",
      "description": "Current TMMi maturity score (1-5). Target: 3.0 this sprint.",
      "gridPos": { "x": 0, "y": 14, "w": 4, "h": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 1,
          "max": 5,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "light-green", "value": 3 },
              { "color": "green", "value": 4 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": true },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "mediverse_qa_maturity_level",
          "legendFormat": "Maturity Level",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "gauge",
      "title": "Requirements Coverage",
      "description": "% requirements with at least 1 test case — Target 100% P1",
      "gridPos": { "x": 4, "y": 14, "w": 4, "h": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "green", "value": 95 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": true },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "mediverse_rtm_coverage_percent",
          "legendFormat": "RTM Coverage %",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Defect Density Trend",
      "description": "Defects per KLoC per sprint",
      "gridPos": { "x": 8, "y": 14, "w": 8, "h": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 1.5 }
            ]
          }
        }
      },
      "options": { "tooltip": { "mode": "single" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "mediverse_defect_density_per_kloc",
          "legendFormat": "Defects/KLoC",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "type": "table",
      "title": "Domain Test Coverage Summary",
      "description": "Pass/fail per medical domain",
      "gridPos": { "x": 16, "y": 14, "w": 8, "h": 6 },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Pass Rate" },
            "properties": [
              { "id": "unit", "value": "percent" },
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "yellow", "value": 80 },
                    { "color": "green", "value": 95 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Pass Rate", "desc": false }]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * mediverse_test_suite_pass_total by (domain) / (mediverse_test_suite_pass_total by (domain) + mediverse_test_suite_fail_total by (domain))",
          "legendFormat": "{{domain}}",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "API Response Time P95 (ms) — QA Suite Runs",
      "description": "P95 latency observed during automated API test runs",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2000 },
              { "color": "red", "value": 4000 }
            ]
          }
        }
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job='curiolearn-backend'}[5m]))) * 1000",
          "legendFormat": "P95 {{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Open Defects by Severity",
      "description": "Active open defects tracked in GitHub Issues",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "S1 Critical" },
            "properties": [{ "id": "color", "value": { "fixedColor": "dark-red", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "S2 High" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
          }
        ]
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "mediverse_open_defects_total{severity='S1'}",
          "legendFormat": "S1 Critical",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "mediverse_open_defects_total{severity='S2'}",
          "legendFormat": "S2 High",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "mediverse_open_defects_total{severity='S3'}",
          "legendFormat": "S3 Medium",
          "refId": "C"
        }
      ]
    }
  ],
  "refresh": "5m",
  "schemaVersion": 39,
  "tags": ["qa", "mediverse", "testing", "kpi"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "qa", "value": "qa" },
        "hide": 0,
        "includeAll": false,
        "name": "env",
        "options": [
          { "selected": true, "text": "qa", "value": "qa" },
          { "selected": false, "text": "staging", "value": "staging" },
          { "selected": false, "text": "production", "value": "production" }
        ],
        "query": "qa,staging,production",
        "type": "custom",
        "label": "Environment"
      }
    ]
  },
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Mediverse QA Engineering KPIs",
  "uid": "mediverse-qa-kpis",
  "version": 1
}
